<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI_Basics.Views.OrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI_Basics.Views"
    xmlns:localData="using:WinUI_Basics.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="#FFFAE4">
        <StackPanel Margin="20">
            <TextBlock Text="Orders" FontSize="26" HorizontalAlignment="Center" Margin="0 5"/>
            <StackPanel Orientation="Horizontal" Margin="10">
                <ComboBox x:Name="StatusFilter" Width="200" PlaceholderText="Select Status" SelectionChanged="StatusFilter_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="localData:Status">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Reset Filters" Click="ResetFiltersButton_Click" Margin="10,0,0,0"/>
            </StackPanel>
            <GridView ItemsSource="{x:Bind FilteredOrders}" >
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="localData:Order">
                        <StackPanel Background="#F4E9CF" Padding="20" Margin="0" BorderBrush="#261A19" BorderThickness="2"  CornerRadius="10" Width="300">
                            <TextBlock FontSize="16">Order ID: <Run Text="{Binding Id}"/></TextBlock>
                            <TextBlock FontSize="16">Status: <Run Text="{Binding Status.Name}"/></TextBlock>
                            <TextBlock FontSize="16">Ordered At: <Run Text="{Binding OrderedAt}"/></TextBlock>
                            <TextBlock FontSize="16" Margin="0,10,0,0">Pizzas:</TextBlock>
                            <ListView ItemsSource="{Binding Pizzas}" IsItemClickEnabled="False">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="localData:Pizza">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="Update Status" Click="UpdateStatusButton_Click" Tag="{Binding}" Visibility="{Binding StatusId, Converter={StaticResource StatusToVisibilityConverter}}"/>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </Grid>
</Page>
