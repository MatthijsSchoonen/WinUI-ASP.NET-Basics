<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI_Basics.Views.MenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI_Basics.Views"
    xmlns:localData="using:WinUI_Basics.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="#FFFAE4">
        <StackPanel Margin="20">
            <TextBlock Text="Menu" FontSize="26" HorizontalAlignment="Center" Margin="0 5"/>
            <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="200" PlaceholderText="Search Pizzas" TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="ToppingsFilter" Width="200" PlaceholderText="Select Topping" SelectionChanged="ToppingsFilter_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="localData:Toppings">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Reset Filters" Click="ResetFiltersButton_Click" Margin="10,0,0,0"/>
            </StackPanel>
            <GridView ItemsSource="{x:Bind FilteredPizzas}" HorizontalAlignment="Center">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="localData:Pizza">
                        <StackPanel Background="#F4E9CF" Padding="20" Margin="0" BorderBrush="#261A19" BorderThickness="2"  CornerRadius="10" Width="300">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding ImgUrl, Converter={StaticResource NullToPlaceholderConverter}}" Width="125" Height="125" Margin="0"/>
                                <StackPanel >
                                    <TextBlock Text="{Binding Name}" FontSize="24" />
                                    <TextBlock>Price € <Run Text="{Binding Price}" FontSize="16"></Run></TextBlock>

                                    <StackPanel Height="100">
                                        <TextBlock Text="Toppings" FontSize="16:"  Margin="0,0,0,10"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ListView ItemsSource="{Binding PizzaToppings}" IsItemClickEnabled="False">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="localData:Toppings">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </ScrollViewer>
                                    </StackPanel>
                                    <Button Content="Add To Cart" Click="OrderButton_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </Grid>
</Page>
