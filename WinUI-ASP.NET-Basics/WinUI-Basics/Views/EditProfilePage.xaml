<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI_Basics.Views.EditProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI_Basics.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="#FFFAE4">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button HorizontalAlignment="Center" Click="Back_Click" Margin="20">Back</Button>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#261A19" BorderThickness="1" Padding="20" CornerRadius="10" Background="#F4E9CF" Width="400">
                <TextBlock Text="Edit Profile" FontSize="26" HorizontalAlignment="Center" Margin="0 5"/>
                <TextBox Width="300" FontSize="16" PlaceholderText="Name" Margin="0 5" x:Name="NameTextBox"/>
                <TextBox Width="300" FontSize="16" PlaceholderText="Email" Margin="0 5" x:Name="EmailTextBox"/>
                <Button Content="Save Changes" FontSize="16" Width="200" HorizontalAlignment="Center" Margin="0 5" Click="SaveChanges_Click"/>
                <TextBlock x:Name="ProfileErrorMessage" FontSize="16" HorizontalAlignment="Center" Foreground="Red"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#261A19" BorderThickness="1" Padding="20"  CornerRadius="10" Background="#F4E9CF" Width="400" Margin="20">
                <TextBlock Text="Reset Password" FontSize="26" HorizontalAlignment="Center" Margin="0 5"/>
                <PasswordBox Width="300" FontSize="16" PlaceholderText="Current Password" Margin="0 5" x:Name="CurrentPasswordBox"/>
                <PasswordBox Width="300" FontSize="16" PlaceholderText="New Password" Margin="0 5" x:Name="NewPasswordBox"/>
                <PasswordBox Width="300" FontSize="16" PlaceholderText="Confirm New Password" Margin="0 5" x:Name="ConfirmNewPasswordBox"/>
                <Button Content="Reset Password" FontSize="16" Width="200" HorizontalAlignment="Center" Margin="0 5" Click="ResetPassword_Click"/>
                <TextBlock x:Name="PasswordErrorMessage" FontSize="16" HorizontalAlignment="Center" Foreground="Red"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>

