<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI_Basics.Views.ReceiptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI_Basics.Views"
    xmlns:localData="using:WinUI_Basics.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="#FFFAE4">
        <TextBlock FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" >Receipts</TextBlock>
        <ListView x:Name="ReceiptListView" Margin="0 30" MaxWidth="300">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="localData:Order">
                    <StackPanel Margin="10" Background="#F4E9CF" MaxWidth="300" HorizontalAlignment="Center" Padding="20" CornerRadius="10">
                        <TextBlock FontWeight="Bold" FontSize="16" >Status: <Run Text="{x:Bind Status.Name}" FontWeight="Bold" FontSize="16"></Run></TextBlock>
                        <TextBlock FontSize="14">Ordered At; <Run Text="{x:Bind OrderedAt}" FontSize="14"/></TextBlock>
                        <TextBlock Text="Pizzas:" FontWeight="Bold" FontSize="14"/>
                        <ItemsControl ItemsSource="{x:Bind Pizzas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="localData:Pizza">
                                    <TextBlock Text="{x:Bind Name}" FontSize="14"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontWeight="Bold" FontSize="14"> Total: €<Run Text="{x:Bind TotalPrice}" /></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
