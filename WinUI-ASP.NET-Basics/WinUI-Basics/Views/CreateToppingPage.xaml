<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI_Basics.Views.CreateToppingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI_Basics.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="#FFFAE4">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="/Assets/PizzeriaLogo.png" Width="150" Margin="0 50"></Image>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#261A19" BorderThickness="1" Padding="20" CornerRadius="10" Background="#F4E9CF" Width="400">
                <TextBlock Text="Create Topping" FontSize="26" HorizontalAlignment="Center" Margin="0 5"/>
                <TextBox Width="300" FontSize="16" PlaceholderText="Topping Name" Margin="0 5" x:Name="ToppingName"/>
                <TextBlock x:Name="ErrorMessage" FontSize="16" HorizontalAlignment="Center" Foreground="Red"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Back" FontSize="16" Width="150" HorizontalAlignment="Left" Margin="5 5" Click="Back_Click"/>
                    <Button Content="Create Topping" FontSize="16" Width="150" HorizontalAlignment="Right" Margin="5 5" Click="CreateTopping_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
